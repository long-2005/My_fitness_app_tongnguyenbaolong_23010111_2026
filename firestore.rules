rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Dữ liệu công khai (read-only, chỉ cần đăng nhập) ────
    // Collection 'foods': danh sách thực phẩm dinh dưỡng
    match /foods/{docId} {
      allow read: if request.auth != null;
      allow write: if false; // Chỉ seeder được ghi (qua Admin SDK)
    }

    // Collection 'exercises': danh sách bài tập calisthenics
    match /exercises/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── Dữ liệu riêng tư của từng user ──────────────────────
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Collection lịch tập (training_schedules) theo user
    match /training_schedules/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
